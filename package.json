{
  "name": "docker-panel",
  "version": "1.0.1",
  "description": "Painel web local para gerenciar todos os containers Docker da máquina",
  "private": true,
  "license": "MIT",
  "author": "Julio Soares",
  "homepage": "https://github.com/JulioSoaresL/ContainerPanel",
  "main": "electron/main.js",
  "desktopName": "io.github.JulioSoaresL.ContainerPanel.desktop",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build:dir": "electron-builder --linux dir -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "io.github.JulioSoaresL.ContainerPanel",
    "npmRebuild": false,
    "productName": "Container Panel",
    "files": [
      "server.js",
      "electron/**",
      "public/**",
      "package.json"
    ],
    "linux": {
      "executableName": "docker-panel",
      "target": "dir",
      "category": "Development"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.15.3"
  }
}
